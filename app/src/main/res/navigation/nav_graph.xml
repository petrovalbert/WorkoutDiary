<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Главный фрагмент со списком тренировок -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.github.workoutdiary.ui.home.HomeFragment"
        android:label="Workout Diary"
        tools:layout="@layout/fragment_home">

        <!-- Действие для перехода к созданию тренировки -->
        <action
            android:id="@+id/action_homeFragment_to_createWorkoutFragment"
            app:destination="@id/createWorkoutFragment" />
    </fragment>

    <!-- Фрагмент создания тренировки (пока заглушка) -->
    <fragment
        android:id="@+id/createWorkoutFragment"
        android:name="com.github.workoutdiary.ui.create.workout.CreateWorkoutFragment"
        android:label="Create Workout"
        tools:layout="@layout/fragment_create_workout">

        <!-- Действие для возврата назад -->
        <action
            android:id="@+id/action_createWorkoutFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>